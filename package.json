{
  "name": "@quickcasa/canada",
  "version": "1.0.0",
  "description": "Canadian provinces and territories, postal codes and GST/HST/PST sales tax rates, with no dependencies.",
  "keywords": [
    "canada",
    "postal-code",
    "province",
    "territory",
    "gst",
    "hst",
    "pst",
    "qst",
    "sales-tax"
  ],
  "homepage": "https://github.com/QuickCasa/canada#readme",
  "bugs": {
    "url": "https://github.com/QuickCasa/canada/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuickCasa/canada.git"
  },
  "license": "MIT",
  "author": "QuickCasa (https://quickcasa.ai)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build && npm run lint"
  },
  "devDependencies": {
    "@quickcasa/eslint-config": "^1.0.0",
    "@types/node": "^22.20.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3"
  }
}
